{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=your-postgres-host; Database=SPOCS; Username=your-user; Password=your-password; SSL Mode=Require;"
  },
  "JwtSettings": {
    "Secret": "YOUR_LONG_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "https://localhost:7157",
    "Audience": "https://localhost:7157",
    "ExpiryInMinutes": 10080
  },
  "AI": {
    "OpenAI": {
      "BaseUrl": "https://openrouter.ai/api/",
      "ApiKey": "your_api_key_here",
      "EmbeddingModel": "text-embedding-3-small",
      "ChatModel": "openai/gpt-4o-mini"
    }
  },
  "AllowedHosts": "*"
}
