# ============================================================
# SPOCS API - Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

ASPNETCORE_ENVIRONMENT=Production
PORT=8080

# Database Connection (PostgreSQL with pgvector extension enabled)
ConnectionStrings__DefaultConnection=Host=your-postgres-host; Database=SPOCS; Username=your-username; Password=your-password; SSL Mode=Require;

# JWT Authentication
JwtSettings__Secret=YOUR_LONG_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JwtSettings__Issuer=https://spocs-api.onrender.com
JwtSettings__Audience=https://spocs-api.onrender.com
JwtSettings__ExpiryInMinutes=10080

# AI Provider (OpenRouter or OpenAI API)
AI__OpenAI__BaseUrl=https://openrouter.ai/api/
AI__OpenAI__ApiKey=your_openrouter_or_openai_api_key
AI__OpenAI__EmbeddingModel=text-embedding-3-small
AI__OpenAI__ChatModel=openai/gpt-4o-mini

# CORS Allowed Origins
AllowedOrigins__0=https://spocs.netlify.app
AllowedOrigins__1=http://localhost:5173

AllowedHosts=*
